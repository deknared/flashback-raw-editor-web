# Cloudflare Workers Assets headers.
#
# No COOP/COEP: the pure-JS Bayer decoder handles One35 DNGs, and the libraw
# worker (foreign-RAW imports since v1.3.0) runs as a plain Web Worker that
# does NOT need SharedArrayBuffer/cross-origin isolation (verified in prod).
# Keeping the headers off also fixes iOS standalone PWA launch (COOP:
# same-origin forces a new browsing context on every open in WKWebView
# standalone mode, causing a blank screen).

# The WASM binary must be served as application/wasm for streaming compile.
/assets/*.wasm
  Content-Type: application/wasm
